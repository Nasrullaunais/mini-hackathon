# ---------------------------------------------------------------------------
# Copy to .env.local. Do NOT commit .env.local.
#
# Two ways to get a database, pick ONE:
#
#   A) Neon (shared, what production uses)  <-- default for the team
#      npm run env:pull        # pulls DATABASE_URL from Vercel into .env.local
#
#   B) Local Docker Postgres (offline fallback)
#      npm run db:up
#      then use the local URL below
# ---------------------------------------------------------------------------

# Option B — local Docker Postgres (docker-compose.yml, host port 5442)
DATABASE_URL="postgres://postgres:postgres@localhost:5442/hackathon"

# Override the host port if 5442 is taken on your machine (docker compose reads this)
# POSTGRES_PORT=5442
