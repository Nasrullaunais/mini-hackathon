# ---------------------------------------------------------------------------
# Copy this to .env.local:   cp .env.example .env.local
#
# That is all the setup there is. The URL below points at the local Docker
# Postgres from docker-compose.yml, so:
#
#   npm run db:up            # start it
#   npm run db:push          # create tables from src/db/schema.ts
#   npm run db:seed          # optional sample rows
#
# Nobody needs to send you credentials. Neon is the deployed app's database and
# only the project owner can reach it (Hobby plan = one Vercel seat) -- see
# "About Neon" in GUIDELINES.md section 1.
#
# Never commit .env.local, and never share it: it carries live Neon credentials
# and a personal Vercel token.
# ---------------------------------------------------------------------------

DATABASE_URL="postgres://postgres:postgres@localhost:5442/hackathon"

# Override the host port if 5442 is taken on your machine (docker compose reads this)
# POSTGRES_PORT=5442
